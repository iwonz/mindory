{
  "platform": "linux",
  "answers": {
    "mindoryHome": "/tmp/mindory-linux",
    "profile": "local-quickstart",
    "dependencyPolicy": "manual",
    "publicUrl": "http://localhost:3000",
    "storage": {
      "provider": "local-fs",
      "localPath": "/data/mindory/objects"
    },
    "antivirus": {
      "mode": "async_quarantine",
      "provider": "clamav",
      "clamavPlatform": "linux/amd64"
    },
    "modalities": {
      "text": true,
      "pdf": true,
      "image": true,
      "audio": true,
      "video": true,
      "videoMaxKeyframes": 10
    },
    "localModels": {
      "preset": "supported-multimodal",
      "resourceConfirmed": true,
      "autoInstall": true,
      "pullRetries": 2
    }
  },
  "expected": {
    "composeProfiles": ["clamav", "local-models", "local-models-vision", "local-models-ocr", "local-models-asr", "local-models-face"],
    "dependencyFailures": []
  }
}
