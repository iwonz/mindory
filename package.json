{
  "name": "mindory",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "api:validate": "node scripts/validate-api-contract.js",
    "api:runtime:validate": "node scripts/validate-api-runtime-wiring.js",
    "backup:validate": "pnpm --filter @mindory/installer typecheck && node scripts/validate-backup-restore.js",
    "bootstrap:validate": "node scripts/validate-bootstrap-scripts.js",
    "check": "node scripts/check-repo.js",
    "cli:smoke": "node scripts/smoke-cli.js",
    "cli:validate": "node scripts/validate-cli.js",
    "config:generate": "pnpm --filter @mindory/config typecheck && node scripts/generate-env-example.js",
    "config:validate": "pnpm --filter @mindory/config typecheck && node scripts/validate-config-catalog.js",
    "compose:validate": "node scripts/validate-compose.js",
    "db:generate": "pnpm --filter @mindory/db db:generate",
    "db:migrate": "pnpm --filter @mindory/db db:migrate",
    "db:repositories:validate": "node scripts/validate-db-repositories.js",
    "db:validate": "node scripts/validate-db-schema.js",
    "documents:validate": "node scripts/validate-document-pipeline.js",
    "hermes:contract": "node scripts/smoke-hermes-contract.js",
    "hermes:example": "node scripts/smoke-hermes-example-host.js",
    "hermes:harness": "node scripts/smoke-hermes-runtime-harness.js",
    "hermes:validate": "node scripts/validate-hermes-adapter.js",
    "hermes:smoke": "node scripts/smoke-hermes.js",
    "installer:validate": "pnpm --filter @mindory/installer typecheck && node scripts/validate-installer-core.js",
    "installer:matrix:validate": "pnpm --filter @mindory/installer typecheck && node scripts/validate-installer-matrix.js",
    "installer:acceptance": "pnpm --filter @mindory/installer typecheck && node scripts/installer-acceptance.js",
    "jobs:validate": "node scripts/validate-job-semantics.js",
    "lint": "node scripts/lint-repo.js",
    "llm:validate": "pnpm --filter @mindory/llm typecheck && node scripts/validate-llm.js",
    "local-model-profiles:validate": "pnpm --filter @mindory/installer typecheck && node scripts/validate-local-model-compose-profiles.js",
    "local-models:validate": "pnpm --filter @mindory/config typecheck && node scripts/validate-local-model-catalog.js",
    "memory:validate": "node scripts/validate-memory-context.js",
    "mcp:smoke": "node apps/mcp/scripts/smoke-stdio.js",
    "mcp:validate": "node scripts/validate-mcp-server.js",
    "mvp:acceptance": "node scripts/mvp-acceptance.js",
    "mvp:demo": "node scripts/mvp-demo.js up --acceptance",
    "mvp:demo:validate": "node scripts/validate-mvp-demo.js",
    "mvp:down": "node scripts/mvp-demo.js down",
    "mvp:reset": "node scripts/mvp-demo.js reset",
    "mvp:seed": "node scripts/seed-demo.js",
    "mvp:up": "node scripts/mvp-demo.js up",
    "observability:validate": "pnpm --filter @mindory/observability typecheck && node scripts/validate-observability.js",
    "processing:validate": "node scripts/validate-processing-pipeline.js",
    "production:validate": "node scripts/validate-production-hardening.js",
    "public-debt:validate": "node scripts/validate-public-readiness-debt.js",
    "public:validate": "node scripts/validate-public-github-hygiene.js",
    "published-release:acceptance": "node scripts/published-release-acceptance.js",
    "queue:validate": "node scripts/validate-queue.js",
    "release:bundle": "node scripts/build-release-bundle.js",
    "release:notes": "node scripts/generate-release-notes.js",
    "release:validate": "node scripts/validate-release-workflow.js",
    "selfhost:acceptance": "pnpm --filter @mindory/installer typecheck && node scripts/selfhost-acceptance.js",
    "selfhost:gate": "node scripts/selfhost-gate.js",
    "storage:validate": "pnpm --filter @mindory/storage-s3 typecheck && node scripts/validate-storage-adapters.js",
    "typecheck": "node scripts/typecheck-workspaces.js",
    "test": "node scripts/test-integration.js",
    "tasks:validate": "node scripts/validate-tasks.js",
    "workspace:validate": "node scripts/validate-workspace.js"
  },
  "devDependencies": {
    "@types/pg": "^8.11.0",
    "@types/node": "^24.0.0",
    "drizzle-kit": "^0.31.5",
    "typescript": "^5.8.0"
  }
}
