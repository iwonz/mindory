# This file is generated from packages/config/src/catalog.ts.
# Run `pnpm config:generate` after changing the config catalog.

# -----------------------------------------------------------------------------
# Mindory Installer
# -----------------------------------------------------------------------------
MINDORY_HOME=~/.mindory
# local-quickstart | persistent-local | server-domain | dev-test
MINDORY_INSTALL_PROFILE=local-quickstart
MINDORY_INSTALL_RELEASE_CHANNEL=stable
MINDORY_INSTALL_ALLOW_EXPERIMENTAL=false
# ask | manual | auto
MINDORY_INSTALL_DEPENDENCY_POLICY=ask
MINDORY_INSTALL_ROLLBACK_ON_FAILURE=true
MINDORY_INSTALL_DEV_MODE=false

# -----------------------------------------------------------------------------
# Mindory API
# -----------------------------------------------------------------------------
MINDORY_LOG_LEVEL=info
MINDORY_API_HOST=0.0.0.0
MINDORY_API_PORT=3000
MINDORY_PUBLIC_URL=http://localhost:3000
MINDORY_API_RATE_LIMIT_ENABLED=true
MINDORY_API_RATE_LIMIT_WINDOW_MS=60000
MINDORY_API_RATE_LIMIT_MAX=600

# -----------------------------------------------------------------------------
# Metrics Exporter
# -----------------------------------------------------------------------------
MINDORY_METRICS_ENABLED=false
MINDORY_METRICS_PATH=/metrics
MINDORY_METRICS_BEARER_TOKEN=
MINDORY_METRICS_WORKER_HOST=0.0.0.0
MINDORY_METRICS_WORKER_PORT=3001

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
MINDORY_DATABASE_URL=postgresql://mindory:mindory@postgres:5432/mindory

# -----------------------------------------------------------------------------
# Redis / BullMQ
# -----------------------------------------------------------------------------
MINDORY_REDIS_URL=redis://redis:6379
MINDORY_QUEUE_PREFIX=mindory:queue
MINDORY_CACHE_PREFIX=mindory:cache

# -----------------------------------------------------------------------------
# Object Storage
# -----------------------------------------------------------------------------
# local-fs and S3-compatible storage are implemented.
# LibreFS/MinIO profiles bootstrap buckets; external S3-compatible endpoints are access-checked by the installer.

# local-fs | s3
MINDORY_STORAGE_PROVIDER=local-fs
MINDORY_STORAGE_LOCAL_PATH=/data/mindory/objects
MINDORY_S3_ENDPOINT=http://librefs:9000
MINDORY_S3_REGION=us-east-1
MINDORY_S3_BUCKET=mindory
MINDORY_S3_ACCESS_KEY_ID=mindory
MINDORY_S3_SECRET_ACCESS_KEY=mindory-secret
MINDORY_S3_FORCE_PATH_STYLE=true

# -----------------------------------------------------------------------------
# Vector Index
# -----------------------------------------------------------------------------
# pgvector | qdrant
MINDORY_VECTOR_PROVIDER=pgvector
MINDORY_QDRANT_URL=http://qdrant:6333
MINDORY_QDRANT_COLLECTION_PREFIX=mindory
MINDORY_QDRANT_HTTP_PORT=6333
MINDORY_QDRANT_GRPC_PORT=6334

# -----------------------------------------------------------------------------
# Antivirus
# -----------------------------------------------------------------------------
MINDORY_AV_ENABLED=true
MINDORY_AV_PROVIDER=clamav
# disabled | async_quarantine | sync_scan
MINDORY_AV_MODE=async_quarantine
MINDORY_AV_REQUIRED_BEFORE_READ=true
MINDORY_AV_REQUIRED_BEFORE_EXTRACTION=true
MINDORY_AV_REQUIRED_BEFORE_INDEXING=true
# block | allow_with_warning
MINDORY_AV_ON_SCAN_FAILURE=block
# quarantine | delete
MINDORY_AV_ON_INFECTED=quarantine
MINDORY_CLAMAV_HOST=clamav
MINDORY_CLAMAV_PORT=3310
MINDORY_CLAMAV_PLATFORM=linux/amd64
MINDORY_CLAMAV_HEALTH_RETRIES=12
MINDORY_CLAMAV_HEALTH_TIMEOUT_MS=120000

# -----------------------------------------------------------------------------
# Workers
# -----------------------------------------------------------------------------
MINDORY_WORKER_TYPE=all
MINDORY_WORKER_CONCURRENCY=2

# -----------------------------------------------------------------------------
# Document Processing Router
# -----------------------------------------------------------------------------
MINDORY_DOCUMENT_PROCESSING_ROUTING_ENABLED=true
MINDORY_DOCUMENT_PROCESSING_TEXT_ENABLED=true
MINDORY_DOCUMENT_PROCESSING_TEXT_REQUIRED=false
MINDORY_DOCUMENT_PROCESSING_PDF_ENABLED=true
MINDORY_DOCUMENT_PROCESSING_PDF_REQUIRED=false
MINDORY_DOCUMENT_PROCESSING_IMAGE_ENABLED=true
MINDORY_DOCUMENT_PROCESSING_IMAGE_REQUIRED=false
MINDORY_DOCUMENT_PROCESSING_AUDIO_ENABLED=true
MINDORY_DOCUMENT_PROCESSING_AUDIO_REQUIRED=false
MINDORY_DOCUMENT_PROCESSING_VIDEO_ENABLED=true
MINDORY_DOCUMENT_PROCESSING_VIDEO_REQUIRED=false
MINDORY_DOCUMENT_PROCESSING_VIDEO_MAX_KEYFRAMES=10
# manifest | local-command | ffmpeg
MINDORY_DOCUMENT_PROCESSING_VIDEO_KEYFRAME_PROVIDER=manifest
# experimental
MINDORY_DOCUMENT_PROCESSING_VIDEO_KEYFRAME_COMMAND=
# experimental
MINDORY_DOCUMENT_PROCESSING_VIDEO_KEYFRAME_ARGS=
# experimental
MINDORY_DOCUMENT_PROCESSING_VIDEO_KEYFRAME_TIMEOUT_MS=120000
MINDORY_DOCUMENT_PROCESSING_VIDEO_FFMPEG_COMMAND=ffmpeg
MINDORY_DOCUMENT_PROCESSING_VIDEO_FFPROBE_COMMAND=ffprobe

# -----------------------------------------------------------------------------
# Docling Extraction Service
# -----------------------------------------------------------------------------
MINDORY_DOCLING_ENABLED=false
MINDORY_DOCLING_HOST=0.0.0.0
MINDORY_DOCLING_URL=http://docling:8081
MINDORY_DOCLING_TIMEOUT_MS=120000
MINDORY_DOCLING_PORT=8081

# -----------------------------------------------------------------------------
# LLM SDK
# -----------------------------------------------------------------------------
# Per-role providers: disabled | openai-compatible | ollama | local-http | local-command
# Disabled text embeddings reach chunked status and use text fallback search.
# For strict indexed pgvector acceptance, enable a 1536-dimensional text embedding model.

MINDORY_LLM_CHAT_ENABLED=false
# disabled | openai-compatible | ollama | local-http | local-command
MINDORY_LLM_CHAT_PROVIDER=disabled
MINDORY_LLM_CHAT_MODEL=
MINDORY_LLM_CHAT_REQUIRED=false
MINDORY_LLM_CHAT_TIMEOUT_MS=60000
MINDORY_LLM_CHAT_CONCURRENCY=1
MINDORY_LLM_TEXT_EMBEDDING_ENABLED=false
# disabled | openai-compatible | ollama | local-http | local-command
MINDORY_LLM_TEXT_EMBEDDING_PROVIDER=disabled
MINDORY_LLM_TEXT_EMBEDDING_MODEL=
MINDORY_LLM_TEXT_EMBEDDING_DIMENSIONS=
MINDORY_LLM_TEXT_EMBEDDING_REQUIRED=false
MINDORY_LLM_TEXT_EMBEDDING_TIMEOUT_MS=60000
MINDORY_LLM_TEXT_EMBEDDING_CONCURRENCY=1
# experimental
MINDORY_LLM_IMAGE_EMBEDDING_ENABLED=false
# disabled | openai-compatible | ollama | local-http | local-command
# experimental
MINDORY_LLM_IMAGE_EMBEDDING_PROVIDER=local-http
# experimental
MINDORY_LLM_IMAGE_EMBEDDING_MODEL=CLIP ViT-L-16-SigLIP2-256__webli
# experimental
MINDORY_LLM_IMAGE_EMBEDDING_DIMENSIONS=
# experimental
MINDORY_LLM_IMAGE_EMBEDDING_REQUIRED=false
# experimental
MINDORY_LLM_IMAGE_EMBEDDING_TIMEOUT_MS=60000
# experimental
MINDORY_LLM_IMAGE_EMBEDDING_CONCURRENCY=1
# experimental
MINDORY_LLM_VISION_CAPTIONING_ENABLED=false
# disabled | openai-compatible | ollama | local-http | local-command
# experimental
MINDORY_LLM_VISION_CAPTIONING_PROVIDER=disabled
# experimental
MINDORY_LLM_VISION_CAPTIONING_MODEL=
# experimental
MINDORY_LLM_VISION_CAPTIONING_REQUIRED=false
# experimental
MINDORY_LLM_VISION_CAPTIONING_TIMEOUT_MS=60000
# experimental
MINDORY_LLM_VISION_CAPTIONING_CONCURRENCY=1
# experimental
MINDORY_LLM_OCR_ENABLED=false
# disabled | openai-compatible | ollama | local-http | local-command
# experimental
MINDORY_LLM_OCR_PROVIDER=local-http
# experimental
MINDORY_LLM_OCR_MODEL=ESLAV__PP-OCRv5_mobile
# experimental
MINDORY_LLM_OCR_REQUIRED=false
# experimental
MINDORY_LLM_OCR_TIMEOUT_MS=60000
# experimental
MINDORY_LLM_OCR_CONCURRENCY=1
# experimental
MINDORY_LLM_ASR_ENABLED=false
# disabled | openai-compatible | ollama | local-http | local-command
# experimental
MINDORY_LLM_ASR_PROVIDER=disabled
# experimental
MINDORY_LLM_ASR_MODEL=
# experimental
MINDORY_LLM_ASR_REQUIRED=false
# experimental
MINDORY_LLM_ASR_TIMEOUT_MS=60000
# experimental
MINDORY_LLM_ASR_CONCURRENCY=1
# experimental
MINDORY_LLM_FACE_DETECTION_ENABLED=false
# disabled | openai-compatible | ollama | local-http | local-command
# experimental
MINDORY_LLM_FACE_DETECTION_PROVIDER=local-http
# experimental
MINDORY_LLM_FACE_DETECTION_MODEL=buffalo_l
# experimental
MINDORY_LLM_FACE_DETECTION_REQUIRED=false
# experimental
MINDORY_LLM_FACE_DETECTION_TIMEOUT_MS=60000
# experimental
MINDORY_LLM_FACE_DETECTION_CONCURRENCY=1
# experimental
MINDORY_LLM_FACE_RECOGNITION_ENABLED=false
# disabled | openai-compatible | ollama | local-http | local-command
# experimental
MINDORY_LLM_FACE_RECOGNITION_PROVIDER=local-http
# experimental
MINDORY_LLM_FACE_RECOGNITION_MODEL=buffalo_l
# experimental
MINDORY_LLM_FACE_RECOGNITION_REQUIRED=false
# experimental
MINDORY_LLM_FACE_RECOGNITION_TIMEOUT_MS=60000
# experimental
MINDORY_LLM_FACE_RECOGNITION_CONCURRENCY=1
# experimental
MINDORY_LLM_IMAGE_GENERATION_ENABLED=false
# disabled | openai-compatible | ollama | local-http | local-command
# experimental
MINDORY_LLM_IMAGE_GENERATION_PROVIDER=disabled
# experimental
MINDORY_LLM_IMAGE_GENERATION_MODEL=
# experimental
MINDORY_LLM_IMAGE_GENERATION_REQUIRED=false
# experimental
MINDORY_LLM_IMAGE_GENERATION_TIMEOUT_MS=60000
# experimental
MINDORY_LLM_IMAGE_GENERATION_CONCURRENCY=1
# experimental
MINDORY_LLM_AUDIO_GENERATION_ENABLED=false
# disabled | openai-compatible | ollama | local-http | local-command
# experimental
MINDORY_LLM_AUDIO_GENERATION_PROVIDER=disabled
# experimental
MINDORY_LLM_AUDIO_GENERATION_MODEL=
# experimental
MINDORY_LLM_AUDIO_GENERATION_REQUIRED=false
# experimental
MINDORY_LLM_AUDIO_GENERATION_TIMEOUT_MS=60000
# experimental
MINDORY_LLM_AUDIO_GENERATION_CONCURRENCY=1
MINDORY_LLM_OPENAI_COMPATIBLE_BASE_URL=
# none | api-key | oauth-bearer
MINDORY_LLM_OPENAI_COMPATIBLE_AUTH_MODE=none
MINDORY_LLM_OPENAI_COMPATIBLE_API_KEY=
MINDORY_LLM_OPENAI_OAUTH_ACCESS_TOKEN=
MINDORY_LLM_OLLAMA_BASE_URL=http://ollama:11434
MINDORY_LLM_LOCAL_HTTP_BASE_URL=http://llm:8080
# experimental
MINDORY_LLM_LOCAL_COMMAND_TIMEOUT_MS=120000
# experimental
MINDORY_LLM_LOCAL_COMMAND_HEALTHCHECK_COMMAND=
# experimental
MINDORY_LLM_LOCAL_COMMAND_HEALTHCHECK_ARGS=["healthcheck","--role","{role}","--model","{model}"]
# experimental
MINDORY_LLM_LOCAL_COMMAND_OPERATION_COMMAND=
# experimental
MINDORY_LLM_LOCAL_COMMAND_OPERATION_ARGS=["operate","--role","{role}","--model","{model}","--operation","{operation}"]
# experimental
MINDORY_LLM_LOCAL_COMMAND_MAX_INPUT_BYTES=16777216
# experimental
MINDORY_LLM_LOCAL_COMMAND_MAX_OUTPUT_BYTES=67108864

# -----------------------------------------------------------------------------
# MCP
# -----------------------------------------------------------------------------
MINDORY_MCP_ENABLED=true
# stdio
MINDORY_MCP_TRANSPORT=stdio
MINDORY_MCP_API_URL=http://localhost:3000
MINDORY_MCP_API_TOKEN=

# -----------------------------------------------------------------------------
# CLI
# -----------------------------------------------------------------------------
MINDORY_CLI_API_URL=http://localhost:3000
MINDORY_CLI_API_TOKEN=

# -----------------------------------------------------------------------------
# Hermes Adapter
# -----------------------------------------------------------------------------
MINDORY_HERMES_ADAPTER_ENABLED=false
MINDORY_HERMES_API_URL=http://localhost:3000
MINDORY_HERMES_API_TOKEN=
MINDORY_HERMES_DEFAULT_PROJECT=default
MINDORY_HERMES_DEFAULT_USER_PEER=default-user
MINDORY_HERMES_DEFAULT_AGENT_PEER=hermes
MINDORY_HERMES_CONTEXT_TOKEN_BUDGET=3000

# -----------------------------------------------------------------------------
# Integration Tests
# -----------------------------------------------------------------------------
MINDORY_TEST_POSTGRES_PORT=55432
MINDORY_TEST_REDIS_PORT=56379
MINDORY_TEST_QDRANT_PORT=56333
MINDORY_TEST_DATABASE_URL=
MINDORY_TEST_REDIS_URL=
MINDORY_TEST_QDRANT_URL=
MINDORY_TEST_SKIP_DOCKER=false
MINDORY_TEST_SKIP_BUILD=false
MINDORY_TEST_DOCKER_BIN=/usr/local/bin/docker
MINDORY_TEST_FFMPEG_BIN=ffmpeg
MINDORY_TEST_FFPROBE_BIN=ffprobe

# -----------------------------------------------------------------------------
# MVP Acceptance
# -----------------------------------------------------------------------------
MINDORY_E2E_LIVE=false
MINDORY_E2E_API_URL=http://localhost:3000
MINDORY_E2E_REQUIRE_INDEXED=false
# disabled | local | ollama
MINDORY_E2E_MODEL_PROFILE=disabled
MINDORY_DEMO_PROJECT_ID=mindory-demo
MINDORY_DEMO_TOKEN=mindory-demo-token
MINDORY_DEMO_TOKEN_ID=tok_mindory_demo

# -----------------------------------------------------------------------------
# LLM SDK Examples
# -----------------------------------------------------------------------------
# OpenAI-compatible example:
# MINDORY_LLM_TEXT_EMBEDDING_ENABLED=true
# MINDORY_LLM_TEXT_EMBEDDING_PROVIDER=openai-compatible
# MINDORY_LLM_TEXT_EMBEDDING_MODEL=text-embedding-3-small
# MINDORY_LLM_TEXT_EMBEDDING_DIMENSIONS=1536
# MINDORY_LLM_OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1
# MINDORY_LLM_OPENAI_COMPATIBLE_AUTH_MODE=api-key
# MINDORY_LLM_OPENAI_COMPATIBLE_API_KEY=sk-...

# OpenAI-compatible OAuth bearer example:
# MINDORY_LLM_TEXT_EMBEDDING_ENABLED=true
# MINDORY_LLM_TEXT_EMBEDDING_PROVIDER=openai-compatible
# MINDORY_LLM_TEXT_EMBEDDING_MODEL=text-embedding-3-small
# MINDORY_LLM_TEXT_EMBEDDING_DIMENSIONS=1536
# MINDORY_LLM_OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1
# MINDORY_LLM_OPENAI_COMPATIBLE_AUTH_MODE=oauth-bearer
# MINDORY_LLM_OPENAI_OAUTH_ACCESS_TOKEN=<host-supplied-access-token>

# Ollama example:
# MINDORY_LLM_TEXT_EMBEDDING_ENABLED=true
# MINDORY_LLM_TEXT_EMBEDDING_PROVIDER=ollama
# MINDORY_LLM_TEXT_EMBEDDING_MODEL=<1536-dimensional-local-embedding-model>
# MINDORY_LLM_TEXT_EMBEDDING_DIMENSIONS=1536
# MINDORY_LLM_OLLAMA_BASE_URL=http://ollama:11434
