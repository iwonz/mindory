{
  "schema_version": 1,
  "description": "Compose assets that must be included in a Mindory release bundle before the installer renders host-specific copies.",
  "assets": [
    {
      "path": "docker-compose.yml",
      "type": "compose",
      "required": true
    },
    {
      "path": "docker-compose.override.yml",
      "type": "compose-override",
      "required": false
    },
    {
      "path": "Dockerfile",
      "type": "image-build",
      "required": true
    },
    {
      "path": ".env.example",
      "type": "env-template",
      "required": true
    },
    {
      "path": "deploy/local-models/ocr/tesseract/Dockerfile",
      "type": "local-model-image-build",
      "required": true
    },
    {
      "path": "deploy/local-models/ocr/tesseract/server.py",
      "type": "local-model-runtime",
      "required": true
    },
    {
      "path": "deploy/local-models/asr/faster-whisper/Dockerfile",
      "type": "local-model-image-build",
      "required": true
    },
    {
      "path": "deploy/local-models/asr/faster-whisper/server.py",
      "type": "local-model-runtime",
      "required": true
    }
  ],
  "mindory_home_directories": [
    "config",
    "data/postgres",
    "data/redis",
    "data/objects",
    "data/librefs",
    "data/models",
    "data/ollama",
    "logs",
    "backups",
    "install"
  ]
}
